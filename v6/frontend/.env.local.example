# ─────────────────────────────────────────────────────────────────────────────
#  V6 frontend — live backend connection
#
#  Copy this file to `.env.local` and fill in the two values the Colab "Serve"
#  cell prints each session. Restart `npm run dev` after editing.
#
#  You can ALSO set these at runtime from the app's Settings panel (gear icon)
#  without touching files — handy while Colab is still warming up.
# ─────────────────────────────────────────────────────────────────────────────

# The public ngrok HTTPS URL printed by the serve cell, e.g.
#   https://1a2b-34-56-78-90.ngrok-free.app
NEXT_PUBLIC_NGROK_URL=https://YOUR-NGROK-SUBDOMAIN.ngrok-free.app

# The V6_API_TOKEN printed by the serve cell (every endpoint requires it).
NEXT_PUBLIC_API_TOKEN=
