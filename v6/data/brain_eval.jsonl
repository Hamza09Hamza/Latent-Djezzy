// v6/data/brain_eval.jsonl — HAND-WRITTEN, held-out brain evaluation cases.
// These phrasings are intentionally NOT drawn from brain_data.py's templates,
// so accuracy here measures generalization, not template memorization. Lines
// starting with // are comments (skipped by eval_brain.py). Each case asserts
// any of: expect_intent, expect_action (first action), expect_continue (go vs
// stop, judged against BRAIN_SEUIL). step_log entries:
//   {action, ok, error_type, row_bucket, attempt}.
//
// ── INTENT: greeting ─────────────────────────────────────────────────────
{"id":"greet-1","query":"morning! hope you're doing well today","expect_intent":"greeting","tags":["intent","greeting"],"note":"casual greeting, no template match"}
{"id":"greet-2","query":"thanks a million, that's exactly what I needed","expect_intent":"greeting","tags":["intent","greeting"],"note":"closing thanks"}
{"id":"greet-3","query":"salam, labas? wach rak?","expect_intent":"greeting","tags":["intent","greeting","darija"],"note":"darija greeting"}
{"id":"greet-4","query":"bonjour, comment se passe ta journée ?","expect_intent":"greeting","tags":["intent","greeting","fr"],"note":"french greeting"}
{"id":"greet-5","query":"alright, catch you later then","expect_intent":"greeting","tags":["intent","greeting"],"note":"sign-off"}
