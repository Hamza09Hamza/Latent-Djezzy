{"id":"meta-1","query":"what sort of things are you actually able to help me with?","expect_intent":"meta","tags":["intent","meta"],"note":"capability question, natural phrasing"}
{"id":"meta-2","query":"are you a real analyst or just a bot?","expect_intent":"meta","tags":["intent","meta"],"note":"identity question"}
{"id":"meta-3","query":"give me a quick rundown of what this assistant does","expect_intent":"meta","tags":["intent","meta"],"note":"overview request"}
{"id":"meta-4","query":"how does this whole thing work behind the scenes?","expect_intent":"meta","tags":["intent","meta"],"note":"how-it-works"}
